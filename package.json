{
  "name": "aurum-terminal",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Aurum Terminal — theo dõi giá vàng realtime: SJC, DOJI, PNJ, giá vàng thế giới.",
  "scripts": {
    "dev": "tsx server.ts",
    "prebuild": "node gold/frontend/scripts/gen-sw-version.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "NODE_ENV=production node server.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.0",
    "lightweight-charts": "4.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "vite": "6.0.7",
    "vitest": "3.2.7"
  }
}
