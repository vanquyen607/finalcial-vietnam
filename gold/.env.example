# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Sinh token: python -c "import secrets; print(secrets.token_hex(32))"

# Bắt buộc đặt khi public — API ghi yêu cầu header X-Api-Token.
GOLD_API_TOKEN=

# Origin frontend khi deploy tách domain, cách nhau dấu phẩy. Bỏ trống = cùng origin.
GOLD_CORS_ORIGINS=

# Rate limit /api (request/phút/IP). 0 = tắt.
GOLD_RATE_LIMIT_PER_MIN=120

# Telegram báo sự cố nguồn giá. Tạo bot qua @BotFather, lấy chat id qua @userinfobot.
GOLD_TELEGRAM_BOT_TOKEN=
GOLD_TELEGRAM_CHAT_ID=
GOLD_TELEGRAM_ALERT_AFTER_SEC=600

# Multi-worker: worker API-only đặt false (chung volume DB với container poller).
GOLD_ENABLE_POLLER=true

# Ghi đè khi cần.
# GOLD_PROVIDER=vangtoday
# GOLD_POLL_INTERVAL=30
